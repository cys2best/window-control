# Python-generated files
__pycache__/
*.py[oc]
build/work/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.superpowers/*
docs/*
!docs/TROUBLESHOOTING.md

# Downloaded binary assets (fetched at startup by download_assets.py)
src/assets/mediamtx/
src/assets/scrcpy/

# Runtime crash logs (written to ProgramData at runtime, never tracked)
service_crash.log
*service_crash.log

# Git worktrees (superpowers subagent-driven-development scratch)
.worktrees/

# Local secrets (PUBLIC_UI_URL/TUNNEL_SECRET/AUTH_TOKEN/VPS_SIGNALING_URL etc.)
.env

# Terraform staging/state
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl