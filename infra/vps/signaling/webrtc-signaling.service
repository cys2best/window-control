[Unit]
Description=WebRTC PoC Signaling Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/webrtc-signaling
EnvironmentFile=/opt/webrtc-signaling/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=2
User=webrtc
Group=webrtc

[Install]
WantedBy=multi-user.target
