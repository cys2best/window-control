map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name ${REMOTE_DOMAIN};
    ssl_certificate /run/certs/edge-fullchain.pem;
    ssl_certificate_key /run/certs/edge-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/stderr warn;
    root /usr/share/nginx/html;
    client_max_body_size 64k;
    location = /connect {
        proxy_pass http://broker:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 75s;
        proxy_send_timeout 30s;
    }
    location ~ ^/installations(/[a-f0-9]{32})?$ {
        proxy_pass http://broker:8000;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location = /.well-known/apple-app-site-association {
        alias /run/association/apple-app-site-association;
        default_type application/json;
    }
    location / {
        try_files $uri $uri.html $uri/ =404;
    }
}
