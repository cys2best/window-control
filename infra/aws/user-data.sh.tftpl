#!/bin/bash
# Idempotent host bootstrap. Holds no secrets: the deploy script fetches them from SSM at deploy time.
set -euo pipefail

COMPOSE_VERSION=v2.32.4
COMPOSE_SHA256=0c4591cf3b1ed039adcd803dbbeddf757375fc08c11245b0154135f838495a2f
DATA_DEVICE=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${data_volume_id}

dnf install -y docker
systemctl enable --now docker

plugin=/usr/libexec/docker/cli-plugins/docker-compose
if ! echo "$COMPOSE_SHA256  $plugin" | sha256sum -c --status 2>/dev/null; then
  mkdir -p "$(dirname "$plugin")"
  curl -fsSL -o /tmp/docker-compose "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-aarch64"
  echo "$COMPOSE_SHA256  /tmp/docker-compose" | sha256sum -c --status
  install -m 0755 /tmp/docker-compose "$plugin"
  rm -f /tmp/docker-compose
fi

if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024
  chmod 600 /swapfile
  mkswap /swapfile
fi
swapon --show | grep -q /swapfile || swapon /swapfile
grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab

# The data volume is attached after launch; wait for it, format only if blank.
for _ in $(seq 1 60); do
  [ -e "$DATA_DEVICE" ] && break
  sleep 5
done
[ -e "$DATA_DEVICE" ]
blkid "$DATA_DEVICE" >/dev/null || mkfs.xfs "$DATA_DEVICE"
mkdir -p /srv/shared-remote/data
grep -q ' /srv/shared-remote/data ' /etc/fstab || echo "$DATA_DEVICE /srv/shared-remote/data xfs defaults,nofail 0 2" >> /etc/fstab
mountpoint -q /srv/shared-remote/data || mount /srv/shared-remote/data

install -d -m 0755 /srv/shared-remote/releases
install -d -m 0700 /srv/shared-remote/secrets
