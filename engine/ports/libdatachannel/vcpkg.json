{
  "name": "libdatachannel",
  "version": "0.21.1",
  "port-version": 1,
  "description": "C/C++ WebRTC network library configured with libnice ICE backend",
  "homepage": "https://github.com/paullouisageneau/libdatachannel",
  "license": "MPL-2.0",
  "dependencies": [
    "libnice",
    "openssl",
    "plog",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "srtp": {
      "description": "Enable SRTP support",
      "dependencies": [
        "libsrtp"
      ]
    }
  }
}
